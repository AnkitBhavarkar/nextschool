# Environment variables for NextSchool WhatsApp Communication Management Platform
# Copy this file to .env and configure values before starting the application.

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=nextschool
# For Docker network use host 'db', for local outside docker use 'localhost'
DB_HOST=db
DB_PORT=5432
DB_URL=postgresql+asyncpg://postgres:postgres_dev_password@db:5432/nextschool

# Application Security & Auth
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS Configuration
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap Initial Accounts (One-time secure initialization)
# Leave these configured to auto-create initial accounts on first launch
BOOTSTRAP_ADMIN_EMAIL=admin@nextschool.internal
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePass2026!
BOOTSTRAP_ADMIN_NAME=Principal Sharma

BOOTSTRAP_TEACHER_EMAIL=teacher1@nextschool.internal
BOOTSTRAP_TEACHER_PASSWORD=TeacherSecurePass2026!
BOOTSTRAP_TEACHER_NAME=Mrs. Ananya Verma

